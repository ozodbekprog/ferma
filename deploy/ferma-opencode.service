[Unit]
Description=Ferma opencode (tmux sessiyasi)
After=default.target

[Service]
Type=forking
ExecStart=/bin/sh -c "tmux has-session -t opencode 2>/dev/null || tmux new-session -d -s opencode -c $HOME $HOME/.opencode/bin/opencode"
ExecStop=/usr/bin/tmux kill-session -t opencode
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
