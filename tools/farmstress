#!/usr/bin/env python3
"""Ferma stress testi: CPU + RAM + disk I/O + GPU kuzatuvi.

Xavfsiz: RAM jami xotiraning ~15% i (yoki --ram-gb), disk 512MB (yoki --disk-mb).
Natija: oxirida bitta PASS/FAIL qatori + maksimal ko'rsatkichlar.
"""
import argparse
import hashlib
import multiprocessing as mp
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time

STOP = None


def total_ram_gb():
    try:
        return os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE") / 1e9
    except Exception:
        pass
    try:
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    return int(line.split()[1]) / 1e6
    except Exception:
        pass
    return 8.0


def cpu_worker(seconds, q):
    data = os.urandom(1 << 20)
    t0 = time.time()
    n = 0
    while time.time() - t0 < seconds:
        hashlib.sha256(data).digest()
        hashlib.md5(data).digest()
        n += 1
    q.put(n)


def ram_worker(seconds, gb, q):
    chunk = 64 * 1024 * 1024
    blocks = max(1, int(gb * 1e9 // chunk))
    buf = []
    try:
        t0 = time.time()
        for i in range(blocks):
            b = bytearray(chunk)
            for j in range(0, chunk, 4096):
                b[j] = i & 0xFF
            buf.append(b)
            if time.time() - t0 > seconds:
                break
        while time.time() - t0 < seconds:
            for b in buf:
                b[0] = (b[0] + 1) & 0xFF
            time.sleep(0.05)
        q.put(round(len(buf) * chunk / 1e9, 2))
    finally:
        buf.clear()


def disk_worker(seconds, mb, q):
    d = tempfile.mkdtemp(prefix="ferma-stress-")
    path = os.path.join(d, "io.bin")
    block = os.urandom(4 * 1024 * 1024)
    written = 0
    read = 0
    t0 = time.time()
    try:
        with open(path, "wb", buffering=0) as f:
            while time.time() - t0 < seconds:
                for _ in range(max(1, mb // 4)):
                    f.write(block)
                    written += len(block)
                f.flush()
                os.fsync(f.fileno())
                if written > mb * 1e6 * 2:
                    break
        with open(path, "rb", buffering=0) as f:
            while True:
                data = f.read(len(block))
                if not data:
                    break
                read += len(data)
        q.put((round(written / 1e6), round(read / 1e6)))
    finally:
        shutil.rmtree(d, ignore_errors=True)


def gpu_monitor(seconds, out):
    t0 = time.time()
    gmax = {"util": 0, "mem": 0, "temp": 0, "power": 0.0}
    while time.time() - t0 < seconds:
        try:
            r = subprocess.run(
                ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,temperature.gpu,power.draw",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=5)
            for line in r.stdout.strip().splitlines():
                parts = [p.strip() for p in line.split(",")]
                if len(parts) >= 4:
                    gmax["util"] = max(gmax["util"], int(float(parts[0])))
                    gmax["mem"] = max(gmax["mem"], int(float(parts[1])))
                    gmax["temp"] = max(gmax["temp"], int(float(parts[2])))
                    gmax["power"] = max(gmax["power"], float(parts[3]))
        except Exception:
            pass
        time.sleep(2)
    out.append(gmax)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--seconds", type=int, default=75)
    ap.add_argument("--cpu", type=int, default=0, help="CPU worker soni (0=avto)")
    ap.add_argument("--ram-gb", type=float, default=0, help="0=avto (jami 15%%)")
    ap.add_argument("--disk-mb", type=int, default=512)
    args = ap.parse_args()

    try:
        host = os.uname().nodename
    except AttributeError:
        import socket
        host = socket.gethostname()
    cpu_n = args.cpu or (os.cpu_count() or 4)
    ram_gb = args.ram_gb or round(max(1.0, total_ram_gb() * 0.15), 1)

    print(f"[{host}] STRESS: {args.seconds}s | CPU x{cpu_n} | RAM {ram_gb}GB | "
          f"disk {args.disk_mb}MB", flush=True)

    q = mp.Queue()
    procs = []
    for _ in range(cpu_n):
        p = mp.Process(target=cpu_worker, args=(args.seconds, q))
        p.start()
        procs.append(p)
    p_ram = mp.Process(target=ram_worker, args=(args.seconds, ram_gb, q))
    p_ram.start()
    procs.append(p_ram)
    p_disk = mp.Process(target=disk_worker, args=(args.seconds, args.disk_mb, q))
    p_disk.start()
    procs.append(p_disk)

    gmax_out = []
    has_gpu = shutil.which("nvidia-smi") is not None
    if has_gpu:
        threading.Thread(target=gpu_monitor, args=(args.seconds, gmax_out), daemon=True).start()

    load_max = 0.0
    t0 = time.time()
    while time.time() - t0 < args.seconds:
        try:
            load_max = max(load_max, os.getloadavg()[0])
        except Exception:
            pass
        time.sleep(3)
        print(f"  ... {int(time.time() - t0)}s yuk={load_max:.1f}", flush=True)

    for p in procs:
        p.join(timeout=15)
        if p.is_alive():
            p.terminate()

    iters = []
    ram_done = 0.0
    disk_done = (0, 0)
    while not q.empty():
        v = q.get()
        if isinstance(v, int):
            iters.append(v)
        elif isinstance(v, float):
            ram_done = v
        elif isinstance(v, tuple):
            disk_done = v

    gpu_txt = ""
    if gmax_out:
        g = gmax_out[0]
        gpu_txt = (f" | GPU util={g['util']}% mem={g['mem']}MB "
                   f"temp={g['temp']}C power={g['power']}W")

    total_iters = sum(iters)
    ok = total_iters > 0 and ram_done > 0 and disk_done[0] > 0
    print(f"[{host}] {'PASS' if ok else 'FAIL'}: {args.seconds}s yuk_max={load_max:.1f} "
          f"cpu_iters={total_iters} ram={ram_done}GB disk_yoz={disk_done[0]}MB "
          f"disk_oqish={disk_done[1]}MB{gpu_txt}", flush=True)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
